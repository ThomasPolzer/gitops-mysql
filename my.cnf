#
# Typische MySQL / MariaDB Konfigurationsdatei
# Speicherort üblicherweise: /etc/mysql/my.cnf oder /etc/my.cnf
#
# Nach Änderungen Dienst neu starten:
#   sudo systemctl restart mysql
#

[client]
port                    = 3306
socket                  = /var/run/mysqld/mysqld.sock
default-character-set  = utf8mb4

[mysqld]
# --- Netzwerk & Basis ---
user                    = mysql
port                    = 3306
socket                  = /var/run/mysqld/mysqld.sock
pid-file                = /var/run/mysqld/mysqld.pid
datadir                 = /var/lib/mysql
#bind-address            = 127.0.0.1
bind-address            = 0.0.0.0
skip-name-resolve

# --- Zeichensatz ---
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# --- Verbindungen ---
max_connections         = 151
max_allowed_packet      = 64M
wait_timeout            = 600
interactive_timeout     = 600

# --- InnoDB (Standard-Storage-Engine) ---
default-storage-engine         = InnoDB
innodb_buffer_pool_size        = 1G        # ca. 60-70% des verfügbaren RAM
innodb_log_file_size           = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method            = O_DIRECT
innodb_file_per_table          = 1

# --- Query Cache (bei MySQL 8+ entfernt, für MariaDB relevant) ---
# query_cache_type      = 1
# query_cache_size      = 64M

# --- Logging ---
log_error               = /var/log/mysql/error.log
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/slow.log
long_query_time         = 2
log_queries_not_using_indexes = 0

# --- Binäres Logging / Replikation ---
server-id               = 1
log_bin                 = /var/log/mysql/mysql-bin.log
binlog_expire_logs_seconds = 604800   # 7 Tage
max_binlog_size         = 100M

# --- Temporäre Tabellen ---
tmp_table_size          = 64M
max_heap_table_size     = 64M

# --- Sicherheit ---
local_infile            = 0
symbolic-links          = 0

[mysqldump]
quick
max_allowed_packet      = 64M

[mysql]
default-character-set  = utf8mb4

[isamchk]
key_buffer              = 16M
